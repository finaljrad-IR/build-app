{
  "name": "build-app",
  "version": "0.9.8",
  "description": "Build system for full-stack JS applications",
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier \"lib/**/*.{js,json,css,ts,tsx}\" --write"
  },
  "author": "Erik Sytnyk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/build-js-app/build-app.git"
  },
  "engines": {
    "node": ">=6"
  },
  "bin": {
    "app-scripts": "./bin/app-scripts.js",
    "napp": "./bin/app-scripts.js"
  },
  "dependencies": {
    "archiver": "5.0.0",
    "chalk": "1.1.3",
    "chokidar": "2.0.0",
    "cli-clear": "1.0.4",
    "command-exists": "1.2.4",
    "cross-spawn": "6.0.6",
    "date-fns": "1.28.5",
    "del": "6.0.0",
    "download-git-repo": "1.0.1",
    "ejs": "3.1.6",
    "esbuild": "0.13.15",
    "esbuild-node-externals": "1.4.0",
    "fkill": "5.3.0",
    "fs-extra": "2.1.2",
    "global-modules": "0.2.3",
    "globby": "11.0.0",
    "inquirer": "8.2.7",
    "json-loader": "0.5.4",
    "klaw-sync": "2.0.0",
    "moment": "2.19.3",
    "nodemon": "1.14.11",
    "ps-list": "4.0.0",
    "semver": "5.7.2",
    "update-notifier": "4.0.0",
    "validate-npm-package-name": "3.0.0",
    "yargs": "7.0.2"
  },
  "devDependencies": {
    "@types/fs-extra": "2.0.0",
    "@types/lodash": "4.14.55",
    "@types/node": "6.0.79"
  }
